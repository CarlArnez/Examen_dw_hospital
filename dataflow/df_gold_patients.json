{
	"name": "df_gold_patients",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_gold_patients_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT\\n    patient_id AS patient_id_bk,\\n    full_name AS nombre_completo,\\n    CASE \\n        WHEN gender = \\'Male\\' THEN \\'Masculino\\'\\n        WHEN gender = \\'Female\\' THEN \\'Femenino\\'\\n        ELSE \\'Otro\\'\\n    END AS genero,\\n    date_of_birth AS fecha_nacimiento,\\n    CASE \\n        WHEN DATEDIFF(YEAR, date_of_birth, GETDATE()) <= 18 THEN \\'0-18\\'\\n        WHEN DATEDIFF(YEAR, date_of_birth, GETDATE()) BETWEEN 19 AND 35 THEN \\'19-35\\'\\n        WHEN DATEDIFF(YEAR, date_of_birth, GETDATE()) BETWEEN 36 AND 60 THEN \\'36-60\\'\\n        ELSE \\'60+\\'\\n    END AS rango_etario,\\n    email AS correo_electronico,\\n    address AS direccion,\\n    insurance_provider AS proveedor_seguro\\nFROM silver.patients',",
				"     format: 'query') ~> source1",
				"source1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id_bk,",
				"          nombre_completo,",
				"          genero,",
				"          fecha_nacimiento,",
				"          rango_etario,",
				"          correo_electronico,",
				"          direccion,",
				"          proveedor_seguro",
				"     )) ~> sink1"
			]
		}
	}
}